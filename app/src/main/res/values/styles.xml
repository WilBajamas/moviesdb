<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--    Text-->
    <style name="HeaderText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/opensans_bold</item>
    </style>

    <style name="HeaderText.MediumBlack" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/opensans_bold</item>
    </style>

    <style name="HeaderText.PrimaryColor" parent="TextAppearance.AppCompat">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="DescriptionText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_grey</item>
        <item name="android:fontFamily">@font/opensans_semi_bold</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="HeaderText.Medium">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/opensans_bold</item>
    </style>

    <style name="SectionText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TitleText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TitleText.Bold" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_bold</item>
    </style>

    <style name="TitleText.White" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/off_white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TitleText.WhiteBold" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/off_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/opensans_bold</item>
    </style>

    <style name="TitleText.Small" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TitleText.SmallBold" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/opensans_bold</item>
    </style>

    <style name="TitleText.Gradient" parent="TextAppearance.AppCompat">
        <item name="android:background">@drawable/background_gradient</item>
    </style>

    <style name="TextFieldErrorAppearance" parent="TextAppearance.Design.Error">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="Tagline" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/off_white_faded</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">italic</item>
    </style>


    <!--    Shapes-->
    <style name="CircularDeterminateProgressBar">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/percentage_bar_circular_green</item>
    </style>

    <style name="DefaultTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!--    Bottom Navigation View-->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSurface">?attr/colorPrimary</item>
        <item name="colorOnSurface">@color/gradient_green_end</item>
        <item name="colorOnSurfaceVariant">@color/text_grey</item>
        <item name="colorSecondaryContainer">@color/gradient_green_end</item>
        <item name="colorOnSecondaryContainer">?attr/colorPrimary</item>
    </style>

    <!--    Full screen dialog animation style-->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/nav_default_enter_anim</item>
        <item name="android:windowExitAnimation">@anim/nav_default_exit_anim</item>
    </style>

    <!--    Chips-->
    <style name="FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/filter_selector</item>
    </style>


</resources>
