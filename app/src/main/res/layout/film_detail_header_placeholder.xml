<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/film_iv_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="140dp"
            app:cardBackgroundColor="@color/background_grey"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="10: 16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/film_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/film_title_tv"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="12dp"
            android:background="@color/background_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/film_iv_view"
            app:layout_constraintTop_toTopOf="@+id/film_iv_view" />

        <View
            android:id="@+id/release_date_tv"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:background="@color/background_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/film_iv_view"
            app:layout_constraintTop_toBottomOf="@+id/film_title_tv" />

        <TextView
            android:id="@+id/film_genres_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:background="@color/background_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/film_iv_view"
            app:layout_constraintTop_toBottomOf="@+id/release_date_tv" />

        <View
            android:id="@+id/rating_view"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/circle_placeholder"
            app:layout_constraintStart_toEndOf="@+id/film_iv_view"
            app:layout_constraintTop_toBottomOf="@+id/film_genres_tv" />


        <View
            android:id="@+id/tagline_tv"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:background="@color/background_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/film_iv_view"
            app:layout_constraintTop_toBottomOf="@+id/film_iv_view" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/film_iv_view"
            app:layout_constraintTop_toBottomOf="@+id/tagline_tv">

            <View
                android:layout_width="match_parent"
                android:layout_height="20sp"
                android:layout_marginTop="2dp"
                android:background="@color/background_grey" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20sp"
                android:layout_marginTop="2dp"
                android:background="@color/background_grey" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20sp"
                android:layout_marginTop="2dp"
                android:background="@color/background_grey" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>